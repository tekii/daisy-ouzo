# MARGOT
# OUZO

[Unit]
Description=MARGOT OUZO - PartyLookup
After=margot.target
BindsTo=margot.target

[Service]
# TODO Restart=on-failure and notify
Type=simple
WorkingDirectory=/home/margot/daisy/ouzo_root
Environment=PYTHONUNBUFFERED=1
Environment="PATH=/home/margot/daisy/ouzo_root/venv/bin"
ExecStart=/home/margot/daisy/ouzo_root/venv/bin/gunicorn --bind :12010 --workers 1 --threads 4 --timeout 0 main:app

[Install]
WantedBy=margot.target
